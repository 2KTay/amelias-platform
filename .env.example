# Amelia's by EAT — environment template.
# Copy to .env for local dev. On cPanel, set these via the host environment
# (SetEnv in .htaccess above web root, or the cPanel "Environment Variables"
# panel). NEVER commit a real .env. Secrets that the Owner rotates in the admin
# Settings screen are stored encrypted in the DB; these are the bootstrap
# fallbacks (env loses to a set DB value — see Settings service, Task 1.3).

APP_NAME="Amelia's by EAT"
APP_ENV=production            # production | staging | local
APP_DEBUG=false
APP_URL=https://ameliasaz.com
APP_TIMEZONE=America/Phoenix

# 32-byte key, base64-encoded, for AES-256-GCM secret encryption (Crypto service).
# Generate: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_KEY=

# Database (cPanel MySQL — least-privilege user, never root in production).
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Absolute path to uploads dir (keep ABOVE web root if DocumentRoot can't target public/).
UPLOADS_PATH=

# --- Integration bootstrap fallbacks (prefer the admin Settings screen) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

SENDGRID_API_KEY=
MAIL_FROM=hello@ameliasaz.com
MAIL_FROM_NAME="Amelia's by EAT"

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# --- Feature gates (flip on when the matching client question is answered) ---
FEATURE_SMS=false            # Q#9  Twilio A2P 10DLC cleared
FEATURE_WINE_DTC=false       # Q#1/#2 wine DTC shipping legally confirmed
FEATURE_GIFTCARD_IMPORT=false # Q#4 Square gift-card balances exported
FEATURE_STRIPE_TAX=false     # Q#8 tax approach = Stripe Tax (else maintained tax_rates)

# --- Backups (cron/backup_db.php) ---
BACKUP_DIR=                  # off-webroot dir for dated mysqldumps
BACKUP_RETENTION_DAYS=30
