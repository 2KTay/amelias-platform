# Normalize line endings to LF — the deploy target is Linux/Apache, and a
# CRLF .htaccess can trigger 500 errors. Force LF on all text/code.
* text=auto eol=lf

*.php   text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.sql   text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
.htaccess text eol=lf
.env.example text eol=lf

# Binary assets — never normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.svg   text eol=lf
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
