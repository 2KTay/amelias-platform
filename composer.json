{
    "name": "amelias/platform",
    "description": "Amelia's by EAT — unified restaurant platform (ordering, reservations, payments, QR feedback, admin).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "stripe/stripe-php": "^16.0",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Amelias\\": "src/"
        },
        "files": [
            "includes/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
